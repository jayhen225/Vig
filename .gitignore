# Python
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Env / secrets
.env

# Rebuildable data -- not committed
data/raw/          # re-pullable from nflverse
data/*.duckdb      # rebuilt by build_warehouse.py / devig_odds.py
data/odds_devig/   # recomputable from the committed data/odds_raw/ snapshots

# NOTE: data/odds_raw/ is intentionally NOT ignored if you want odds
# snapshots preserved. If so, add an exception below instead of
# ignoring all of data/. See note below.

# Editors / OS
.DS_Store
.idea/
.vscode/
# Everything under parlay/data is local/rebuildable (nflverse parquets, duckdb
# warehouses, de-vig output, sql/trace files) EXCEPT the odds snapshots, which
# are capture-or-lose (line movement can't be backfilled) and must be committed.
parlay/data/*
!parlay/data/odds_raw/
# The built warehouse ships with the Vercel deploy so /api/board serves real
# data instead of falling back to sample data -- rebuild + recommit after
# each new odds snapshot with: python parlay/pipeline/devig_odds.py
!parlay/data/nfl_data.duckdb
